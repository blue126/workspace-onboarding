{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Device bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tool_version",
    "device_id",
    "vm_hostname",
    "ssh_gateway",
    "wireguard_address",
    "wireguard_endpoint",
    "tunnel_name",
    "wireguard_public_key",
    "client_wireguard_public_key"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "tool_version": {
      "const": "1.0.0"
    },
    "device_id": {
      "type": "string",
      "pattern": "^ed-[a-z0-9-]{1,25}$"
    },
    "vm_hostname": {
      "type": "string",
      "pattern": "^employee-[a-z0-9-]{1,40}$"
    },
    "ssh_gateway": {
      "type": "string",
      "format": "ipv4"
    },
    "wireguard_address": {
      "type": "string",
      "pattern": "^[0-9.]+/32$"
    },
    "wireguard_endpoint": {
      "type": "string",
      "format": "ipv4"
    },
    "tunnel_name": {
      "type": "string",
      "pattern": "^ws-[a-f0-9]{8}$"
    },
    "wireguard_public_key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]{43}=$"
    },
    "client_wireguard_public_key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]{43}=$"
    }
  }
}
